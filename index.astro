<script>
	let sse_url = "http://"+window.location.hostname+":8000/sse"
	const evtSource = new EventSource(sse_url);
	console.log("Connecting to SSE feed at: "+sse_url);

	evtSource.onmessage = (event) => {
		console.log("Got a message!");
		console.log(event.data);
	};
	evtSource.onopen = () => {
		console.log("Connected to sse feed.")
	}
</script>